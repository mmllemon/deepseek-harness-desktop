{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeepSeek Harness Desktop Config",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "host": { "type": "string", "format": "hostname", "default": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535, "default": 3080 },
        "autoStart": { "type": "boolean", "default": true }
      },
      "required": ["host", "port", "autoStart"],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "default": "deepseek-official" },
        "model": { "type": "string", "default": "deepseek-v4-flash" },
        "apiKey": { "type": "string", "default": "" },
        "baseURL": { "type": "string", "default": "" }
      },
      "required": ["provider", "model", "apiKey", "baseURL"],
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "dataDir": { "type": "string", "default": "" },
        "logDir": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },
    "advanced": {
      "type": "object",
      "properties": {
        "extraEnv": { "type": "object", "additionalProperties": { "type": "string" } },
        "logLevel": { "type": "string", "enum": ["error", "warn", "info", "debug", "trace"], "default": "info" }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": { "theme": { "type": "string", "enum": ["system", "light", "dark"], "default": "system" } },
      "additionalProperties": false
    },
    "updates": {
      "type": "object",
      "properties": { "channel": { "type": "string", "enum": ["stable", "beta"], "default": "stable" } },
      "additionalProperties": false
    }
  },
  "required": ["server", "model", "paths", "advanced", "ui", "updates"],
  "additionalProperties": false
}
