{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面壳默认能力：最小授权原则。sidecar 仅允许 dsh 以固定参数模板启动。",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:webview:allow-navigate",
    "core:webview:default",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/dsh",
          "sidecar": true,
          "args": ["web", "--port", { "validator": "^[0-9]{4,5}$" }]
        }
      ]
    }
  ]
}
