{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "identifier": "com.deepseek.harness.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "<org>",
    "icon": ["icons/icon.ico"],
    "externalBin": ["dsh-x86_64-pc-windows-msvc.exe"],
    "resources": ["../native-mods/*"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://releases.<org>.com/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "<update-pubkey>"
    },
    "shell": {
      "scope": [
        {
          "name": "dsh",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
